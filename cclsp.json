{
  "servers": [
    {
      "extensions": ["ts", "tsx", "js", "jsx"],
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "rootDir": "."
    },
    {
      "extensions": ["vue"],
      "command": ["npx", "-y", "@vue/language-server", "--stdio"],
      "rootDir": "."
    }
  ]
}
