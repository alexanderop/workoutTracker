{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.ts", "src/**/*.vue", "eslint-local-rules/**/*.ts"],
  "project": ["src/**/*.ts", "src/**/*.vue", "eslint-local-rules/**/*.ts"],
  "ignore": [
    ".claude/**",
    "env.d.ts",
    "src/components/ui/**",
    "src/i18n/messages/de/**"
  ],
  "ignoreDependencies": [
    "@antfu/eslint-config",
    "@prettier/plugin-oxc",
    "@testing-library/jest-dom",
    "tailwindcss",
    "tw-animate-css"
  ],
  "vitest": {
    "entry": [
      "src/__tests__/**/*.spec.ts",
      "src/db/__tests__/**/*.spec.ts",
      "src/__tests__/helpers/*.ts",
      "src/__tests__/factories/*.ts"
    ]
  }
}
