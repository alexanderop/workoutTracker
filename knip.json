{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/blocks/index.ts", "eslint-local-rules/**/*.ts"],
  "project": ["src/**/*.ts", "src/**/*.vue", "eslint-local-rules/**/*.ts"],
  "ignore": ["src/components/ui/**", "src/i18n/messages/de/**", "src/types/router.d.ts"],
  "ignoreDependencies": [
    "@antfu/eslint-config",
    "@prettier/plugin-oxc",
    "tailwindcss",
    "tw-animate-css"
  ],
  "vitest": {
    "entry": [
      "src/__tests__/**/*.spec.ts",
      "src/__tests__/**/*.test-d.ts",
      "src/db/__tests__/**/*.spec.ts",
      "src/__tests__/helpers/*.ts",
      "src/__tests__/factories/*.ts"
    ]
  }
}
