# Test screenshots (keep only visual regression baselines)
src/__tests__/integration/__screenshots__/
src/__tests__/a11y/__screenshots__/
src/__tests__/browser/__screenshots__/
src/__tests__/db/__screenshots__/
src/__tests__/composables/**/__screenshots__/
src/__tests__/features/**/__screenshots__/

# Exclude temporary visual regression outputs (keep only platform-specific baselines)
src/__tests__/visual/__screenshots__/**/Visual-Regression-*.png

# Ralph Wiggum automation (temporary output)
.ralph/last-output.txt
.ralph/logs/
.claude/scheduled_tasks.lock

# Scratch directory left behind by anthropics/claude-code-action runs; must
# stay ignored so claude-fix-review.yml's source-only guard sees a clean tree
.claude-pr/
