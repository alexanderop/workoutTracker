flowchart TB
    subgraph MainNav["🧭 Bottom Navigation"]
        Home["Home<br/>/"]
        Workouts["Workouts<br/>/workouts"]
        Exercises["Exercises<br/>/exercises"]
        Settings["Settings<br/>/settings"]
    end

    subgraph WorkoutFlow["💪 Workout Execution Flow"]
        ActiveWorkout["ActiveWorkout<br/>/workout/active"]
        WorkoutSummary["WorkoutSummary<br/>/workout/summary/:id"]
    end

    subgraph TemplateFlow["📋 Template Flow"]
        CreateTemplate["CreateTemplate<br/>/templates/create"]
        TemplateDetail["TemplateDetail<br/>/templates/:id"]
    end

    subgraph BenchmarkFlow["🏆 Benchmark Flow"]
        CreateBenchmark["CreateBenchmark<br/>/benchmarks/create"]
        BenchmarkDetail["BenchmarkDetail<br/>/benchmarks/:id"]
    end

    subgraph HistoryFlow["📊 History Flow"]
        WorkoutDetail["WorkoutDetail<br/>/workouts/:id"]
    end

    subgraph ExerciseFlow["🔧 Exercise Creation"]
        CreateExercise["CreateCustomExercise<br/>/create-exercise"]
    end

    subgraph TimersFlow["⏱️ Standalone Timers"]
        Timers["Timers<br/>/timers"]
    end

    Home -->|"Start Workout"| ActiveWorkout
    Home -->|"Access Timers"| Timers

    ActiveWorkout -->|"Complete"| WorkoutSummary
    ActiveWorkout -->|"Cancel"| Home
    WorkoutSummary -->|"Done"| Home

    Workouts -->|"View History"| WorkoutDetail
    Workouts -->|"Create Template"| CreateTemplate
    Workouts -->|"View Template"| TemplateDetail
    Workouts -->|"Create Benchmark"| CreateBenchmark
    Workouts -->|"View Benchmark"| BenchmarkDetail

    CreateTemplate -->|"Save"| TemplateDetail
    TemplateDetail -->|"Start Workout"| ActiveWorkout

    CreateBenchmark -->|"Save"| BenchmarkDetail
    BenchmarkDetail -->|"Start Workout"| ActiveWorkout

    WorkoutDetail -->|"Redo Workout"| ActiveWorkout

    Exercises -->|"Create Custom"| CreateExercise
    ActiveWorkout -.->|"Add Exercise"| CreateExercise
    CreateExercise -.->|"router.back()"| Exercises
    CreateExercise -.->|"router.back()"| ActiveWorkout

    style Home fill:#4ade80,stroke:#22c55e,stroke-width:3px
    style Workouts fill:#4ade80,stroke:#22c55e,stroke-width:3px
    style Exercises fill:#4ade80,stroke:#22c55e,stroke-width:3px
    style Settings fill:#4ade80,stroke:#22c55e,stroke-width:3px

    style ActiveWorkout fill:#f97316,stroke:#ea580c,stroke-width:3px
    style WorkoutSummary fill:#fbbf24,stroke:#f59e0b,stroke-width:2px

    style TemplateDetail fill:#60a5fa,stroke:#3b82f6,stroke-width:2px
    style BenchmarkDetail fill:#a78bfa,stroke:#8b5cf6,stroke-width:2px
    style WorkoutDetail fill:#94a3b8,stroke:#64748b,stroke-width:2px
