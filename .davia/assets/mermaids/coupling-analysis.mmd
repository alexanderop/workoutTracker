graph LR
    subgraph HighCoupling["⚠️ High Coupling Points"]
        ExercisesStore["exercises store<br/>(Pinia)"]
        WorkoutState["workoutState<br/>(singleton ref)"]
    end

    subgraph Features["Features"]
        Workout["workout/"]
        Templates["templates/"]
        Benchmarks["benchmarks/"]
        Exercises["exercises/"]
        Settings["settings/"]
    end

    subgraph Decoupled["✅ Low Coupling (Good)"]
        Database["Database Layer<br/>(Repository Pattern)"]
        Timers["Timer Composables<br/>(Stateless)"]
        Types["Type Definitions<br/>(Pure Data)"]
    end

    %% High coupling relationships
    Workout -->|"reads/writes"| WorkoutState
    Workout -->|"reads exercise icons"| ExercisesStore
    Templates -->|"reads for thumbnails"| ExercisesStore
    Benchmarks -->|"reads for thumbnails"| ExercisesStore
    Exercises -->|"manages"| ExercisesStore

    %% Decoupled relationships
    Workout -.->|"through interface"| Database
    Templates -.->|"through interface"| Database
    Benchmarks -.->|"through interface"| Database
    Settings -.->|"through interface"| Database

    Workout -.->|"imports functions"| Timers
    Workout -.->|"imports types"| Types
    Templates -.->|"imports types"| Types
    Benchmarks -.->|"imports types"| Types

    classDef highCoupling fill:#ffebee,stroke:#c62828,stroke-width:3px
    classDef mediumCoupling fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef lowCoupling fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    class ExercisesStore,WorkoutState highCoupling
    class Workout,Templates,Benchmarks,Exercises,Settings mediumCoupling
    class Database,Timers,Types lowCoupling
