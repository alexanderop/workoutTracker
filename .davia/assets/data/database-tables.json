[
  {
    "table": "customExercises",
    "type": "DbCustomExercise",
    "purpose": "User-created exercise definitions",
    "primaryKey": "id (string)",
    "indexes": "id, name, muscle, equipment, createdAt",
    "keyFields": "id, name, icon, equipment, muscle, type, metrics, createdAt, updatedAt"
  },
  {
    "table": "workouts",
    "type": "DbCompletedWorkout",
    "purpose": "Historical record of completed workouts",
    "primaryKey": "id (string)",
    "indexes": "id, startedAt, completedAt",
    "keyFields": "id, name, blocks, startedAt, completedAt, durationSeconds, notes, benchmarkId"
  },
  {
    "table": "activeWorkout",
    "type": "DbActiveWorkout",
    "purpose": "Single in-progress workout (singleton)",
    "primaryKey": "id (always 'current')",
    "indexes": "id",
    "keyFields": "id, name, blocks, selectedBlockIndex, startedAt, lastModifiedAt, mode, activeSetIndex, activeExerciseIndex, benchmarkId, globalTimerStartedAt"
  },
  {
    "table": "templates",
    "type": "DbWorkoutTemplate",
    "purpose": "Reusable workout structures",
    "primaryKey": "id (string)",
    "indexes": "id, name, createdAt, lastUsedAt",
    "keyFields": "id, name, blocks, createdAt, lastUsedAt, tags"
  },
  {
    "table": "settings",
    "type": "DbUserSetting",
    "purpose": "User preferences and app configuration",
    "primaryKey": "key (setting name)",
    "indexes": "key",
    "keyFields": "key (theme, defaultRestTimer, weightUnit, heightUnit, autoSaveInterval, screenWakeLock, timerSoundEnabled, language), value"
  },
  {
    "table": "benchmarks",
    "type": "DbBenchmark",
    "purpose": "Standard workouts for performance tracking",
    "primaryKey": "id (string)",
    "indexes": "id, name, createdAt, lastUsedAt",
    "keyFields": "id, name, type (fortime | rounds), rounds, exercises, createdAt, lastUsedAt"
  }
]
