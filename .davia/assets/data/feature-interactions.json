[
  {
    "feature": "workout",
    "responsibility": "Active workout execution & state management",
    "mainComposable": "useWorkout()",
    "sharedDependencies": [
      "exercises store (Pinia) - reads exercise icons/names",
      "workoutState (singleton ref) - shared state across all components",
      "workoutsRepository - save completed workouts",
      "activeWorkoutRepository - auto-save current state",
      "Timer composables (useRestTimer, useAmrapTimer, etc.)",
      "Block types, Workout types"
    ],
    "couplingLevel": "High",
    "cohesion": "Strong - all workout execution logic in one feature",
    "notes": "Central feature with singleton state. High coupling to exercises store for UI metadata (icons, names)"
  },
  {
    "feature": "templates",
    "responsibility": "Workout template creation & management",
    "mainComposable": "useTemplateCreation(), useTemplateDetail()",
    "sharedDependencies": [
      "exercises store - reads for exercise search/selection",
      "templatesRepository - CRUD operations",
      "Block types (creates strength blocks)"
    ],
    "couplingLevel": "Medium",
    "cohesion": "Strong - focused on template lifecycle",
    "notes": "Depends on exercises store for search. Creates workout blocks but doesn't touch workout state directly"
  },
  {
    "feature": "benchmarks",
    "responsibility": "CrossFit benchmark workout definitions",
    "mainComposable": "useBenchmarkForm(), useBenchmarkDetail()",
    "sharedDependencies": [
      "exercises store - reads for exercise metadata",
      "benchmarksRepository - CRUD operations",
      "Exercise types, Block types"
    ],
    "couplingLevel": "Medium",
    "cohesion": "Strong - focused on benchmark definitions",
    "notes": "Similar to templates but for prescribed benchmark workouts (Fran, Murph, etc.)"
  },
  {
    "feature": "exercises",
    "responsibility": "Custom exercise library management",
    "mainComposable": "useExerciseForm()",
    "sharedDependencies": [
      "exercises store (Pinia) - manages custom exercises",
      "customExercisesRepository - persistence"
    ],
    "couplingLevel": "Medium",
    "cohesion": "Strong - dedicated to exercise CRUD",
    "notes": "Tightly coupled to exercises store (it manages it). Other features READ from this store"
  },
  {
    "feature": "settings",
    "responsibility": "App preferences & configuration",
    "mainComposable": "useLanguage(), useTheme()",
    "sharedDependencies": [
      "settings store (Pinia) - theme, language, defaults",
      "settingsRepository - persistence"
    ],
    "couplingLevel": "Low",
    "cohesion": "Medium - handles multiple unrelated settings",
    "notes": "Loosely coupled. No feature dependencies. Pure configuration management"
  },
  {
    "feature": "timers",
    "responsibility": "Standalone timer UI for rest/AMRAP/EMOM/etc",
    "mainComposable": "N/A (uses shared timer composables)",
    "sharedDependencies": [
      "Timer composables from @/composables/timers/"
    ],
    "couplingLevel": "Low",
    "cohesion": "Medium - UI-only feature for standalone timers",
    "notes": "Minimal coupling. Reuses shared timer composables. UI-focused feature"
  }
