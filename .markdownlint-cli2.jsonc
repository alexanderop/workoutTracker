{
  // Respect .gitignore rather than hand-listing generated directories. Without
  // this, `pnpm lint` failed on gitignored Playwright artifacts
  // (`playwright-report/`, `test-results/`) after any local `pnpm test:e2e`,
  // and on `brain/plans/**` — local scratch nobody writes for review.
  // markdownlint-cli2 supports this natively; enumerating the directories by
  // hand only defers the next discovery to whoever hits it.
  "gitignore": true,
  "ignores": ["CHANGELOG.md", ".claude/**"]
}
