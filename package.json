    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.562.0",
    "reka-ui": "^2.7.0",
    "sortablejs": "^1.15.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26",
    "vue-i18n": "^11.2.7",
    "vue-router": "^4.6.4",
    "zod": "^4.3.5"
  },
  "lint-staged": {
    "*.{ts,vue,js}": "eslint --fix --cache",
    "*.md": "markdownlint-cli2 --fix"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
