{
  "name": "workouttracker",
  "type": "module",
  "version": "1.35.0",
  "private": true,
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:exercise-icons": "node scripts/generate-exercise-icons.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run --project=default",
    "test:watch": "vitest --project=default",
    "test:headed": "vitest --project=default --browser.headless=false",
    "test:ui": "vitest --ui --project=default",
    "test:coverage": "vitest run --project=default --coverage",
    "test:a11y": "vitest run --project=a11y",
    "test:visual": "vitest run --project=visual",
    "test:visual:update": "vitest run --project=visual --update",
    "test:arch": "vitest run --project=arch",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix --ignore-path .gitignore",
    "lint:oxlint:check": "oxlint . --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint:eslint:check": "eslint . --cache --max-warnings 1676",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint": "run-s lint:oxlint lint:eslint lint:md lint:tokens",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check lint:md lint:tokens",
    "i18n:check": "pnpm dlx tsx scripts/check-i18n.ts",
    "pr:comments": "pnpm dlx tsx scripts/pr-comments.ts",
    "knip": "knip",
    "size-limit": "size-limit",
    "ralph": "./.ralph/ralph.sh",
    "cpd": "jscpd src",
    "check:composables": "bash scripts/check-composable-usage.sh",
    "lhci": "lhci autorun",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "catalog:ui",
    "@tailwindcss/vite": "catalog:ui",
    "@unovis/ts": "catalog:ui",
    "@unovis/vue": "catalog:ui",
    "@vueuse/core": "catalog:frontend",
    "@vueuse/integrations": "catalog:frontend",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "date-fns": "catalog:frontend",
    "dexie": "catalog:frontend",
    "embla-carousel-vue": "catalog:ui",
    "@lucide/vue": "catalog:ui",
    "reka-ui": "catalog:ui",
    "sortablejs": "catalog:frontend",
    "tailwind-merge": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "web-vitals": "catalog:frontend",
    "zod": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@e18e/eslint-plugin": "catalog:lint",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:lint",
    "@faker-js/faker": "catalog:testing",
    "@intlify/eslint-plugin-vue-i18n": "catalog:lint",
    "@lhci/cli": "catalog:build",
    "@prettier/plugin-oxc": "catalog:lint",
    "@tsconfig/node22": "catalog:build",
    "@types/estree": "catalog:build",
    "@types/jsdom": "catalog:build",
    "@types/node": "catalog:build",
    "@types/sortablejs": "catalog:build",
    "@vite-pwa/assets-generator": "catalog:build",
    "@vitejs/plugin-vue": "catalog:build",
    "@size-limit/file": "catalog:lint",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/eslint-plugin": "catalog:lint",
    "@vitest/ui": "catalog:testing",
    "@vue/eslint-config-prettier": "catalog:lint",
    "@vue/eslint-config-typescript": "catalog:lint",
    "@vue/test-utils": "catalog:testing",
    "@vue/tsconfig": "catalog:build",
    "archunit": "catalog:testing",
    "axe-core": "catalog:testing",
    "eslint": "catalog:lint",
    "eslint-import-resolver-typescript": "catalog:lint",
    "eslint-plugin-import-x": "catalog:lint",
    "eslint-plugin-oxlint": "catalog:lint",
    "eslint-plugin-pnpm": "catalog:lint",
    "eslint-plugin-regexp": "catalog:lint",
    "eslint-plugin-unicorn": "catalog:lint",
    "eslint-plugin-vue": "catalog:lint",
    "fake-indexeddb": "catalog:testing",
    "fast-check": "catalog:testing",
    "husky": "catalog:build",
    "jiti": "catalog:build",
    "jscpd": "catalog:lint",
    "jsdom": "catalog:testing",
    "knip": "catalog:lint",
    "lint-staged": "catalog:lint",
    "markdownlint-cli2": "catalog:lint",
    "npm-run-all2": "catalog:build",
    "oxlint": "catalog:lint",
    "playwright": "catalog:testing",
    "prettier": "catalog:lint",
    "rollup-plugin-visualizer": "catalog:build",
    "size-limit": "catalog:lint",
    "ts-morph": "catalog:build",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vitest": "catalog:testing",
    "vitest-browser-vue": "catalog:testing",
    "vue-tsc": "catalog:build",
    "workbox-build": "catalog:build",
    "workbox-window": "catalog:build"
  },
  "size-limit": [
    {
      "name": "production JavaScript",
      "path": "dist/assets/*.js",
      "limit": "430 kB"
    }
  ],
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": [
      "oxlint --fix --ignore-path .gitignore",
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,yml,yaml}": "prettier --write",
    "*.md": "markdownlint-cli2"
  }
}
