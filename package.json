    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-vue": "~10.6.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jscpd": "^4.0.7",
    "jsdom": "^27.4.0",
    "knip": "^5.80.2",
    "lint-staged": "^16.2.7",
