{
  "name": "workouttracker",
  "type": "module",
  "version": "1.17.0",
  "private": true,
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run --project=default",
    "test:watch": "vitest --project=default",
    "test:headed": "vitest --project=default --browser.headless=false",
    "test:ui": "vitest --ui --project=default",
    "test:coverage": "vitest run --project=default --coverage",
    "test:a11y": "vitest run --project=a11y",
    "test:visual": "vitest run --project=visual",
    "test:visual:update": "vitest run --project=visual --update",
    "test:arch": "vitest run --project=arch",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint": "run-s lint:*",
    "i18n:check": "pnpm dlx tsx scripts/check-i18n.ts",
    "knip": "knip",
    "ralph": "./.ralph/ralph.sh",
    "cpd": "jscpd src",
    "check:composables": "bash scripts/check-composable-usage.sh",
    "lhci": "lhci autorun",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.1",
