{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx tsx '/Users/alexanderopalic/Projects/active/workoutTracker/.codex/hooks/pre-tool-no-else.ts'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pnpm dlx tsx '/Users/alexanderopalic/Projects/active/workoutTracker/.codex/hooks/pre-tool-no-type-assertion.ts'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx tsx '/Users/alexanderopalic/Projects/active/workoutTracker/.codex/hooks/pre-tool-block-non-pnpm.ts'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx tsx '/Users/alexanderopalic/Projects/active/workoutTracker/.codex/hooks/post-tool-typecheck.ts'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alexanderopalic/Projects/active/workoutTracker/.codex/hooks/datetime-context.sh'"
          }
        ]
      }
    ]
  }
}
