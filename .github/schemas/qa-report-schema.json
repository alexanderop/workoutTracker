{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["HEALTHY", "MINOR_ISSUES", "CRITICAL_BUGS"],
      "description": "Overall QA verdict"
    },
    "summary": {
      "type": "string",
      "description": "2-3 sentence health assessment covering what was tested and key findings"
    },
    "tests": {
      "type": "array",
      "description": "Every test performed, in order",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Short test name, e.g. 'Navigate to Weight page'" },
          "area": { "type": "string", "enum": ["navigation", "forms", "core_features", "mobile", "accessibility", "edge_cases"] },
          "result": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "details": { "type": "string", "description": "What you observed — be specific about what you saw on screen" }
        },
        "required": ["name", "area", "result", "details"],
        "additionalProperties": false
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "suggestion"]
          },
          "title": { "type": "string" },
          "description": { "type": "string", "description": "What happened vs what should have happened" },
          "steps_to_reproduce": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Numbered steps a developer can follow to reproduce"
          },
          "expected": { "type": "string", "description": "What should have happened" },
          "actual": { "type": "string", "description": "What actually happened" }
        },
        "required": ["id", "severity", "title", "description", "steps_to_reproduce", "expected", "actual"],
        "additionalProperties": false
      }
    },
    "console_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_tests": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "critical_bugs": { "type": "integer" },
        "major_bugs": { "type": "integer" },
        "minor_bugs": { "type": "integer" }
      },
      "required": ["total_tests", "passed", "failed", "critical_bugs", "major_bugs", "minor_bugs"],
      "additionalProperties": false
    }
  },
  "required": ["verdict", "summary", "tests", "bugs", "console_errors", "metrics"],
  "additionalProperties": false
}
